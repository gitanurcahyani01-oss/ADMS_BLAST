# ==========================================
# ADMS Blast Backend - Environment Config (MySQL cPanel / VPS)
# ==========================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MySQL Multi-Tenant Database Connection URL
# Format cPanel: mysql://cpaneluser_dbuser:password@localhost:3306/cpaneluser_dbname
DATABASE_URL="mysql://root:password@localhost:3306/adms_blast_db"

# JWT Authentication Secret (Gunakan string acak yang panjang dan aman)
JWT_SECRET="adms_blast_secure_jwt_secret_key_2026_super_secure"
JWT_EXPIRES_IN="7d"

# Allowed CORS Client Origins
CLIENT_ORIGIN="https://digitalmarketing.top,https://jasapenyebaranbrosur.biz.id,http://localhost:5173"
